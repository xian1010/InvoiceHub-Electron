{
  "name": "invoicehub-electron",
  "version": "1.0.6",
  "description": "InvoiceHub — Electron + React + Tailwind",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --config electron-builder.yml",
    "postinstall": "node scripts/postinstall.mjs",
    "release": "npm version patch && npm run build:win -- --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "nodemailer": "^8.0.2",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.5.207"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.414.0",
    "postcss": "^8.4.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^3.4.7"
  }
}
